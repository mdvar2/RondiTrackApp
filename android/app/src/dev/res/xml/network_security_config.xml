<?xml version="1.0" encoding="utf-8"?>
<!-- Dev flavour only. Plain HTTP for the one host config/dev.json names:
     127.0.0.1, the laptop's API reached through `adb reverse tcp:8081
     tcp:8081` (a phone over USB, or the emulator). Everything else stays
     HTTPS only. test/android_network_test.dart keeps this list and
     config/dev.json in step. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
